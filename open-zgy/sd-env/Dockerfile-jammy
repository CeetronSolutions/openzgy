#############################################################################
###   Environment is ready, build SDAPI now!   ##############################
#############################################################################

FROM sdapi-manual AS sdapi-build

# SOURCE CODE FROM BUILD CONTEXT COPIED IN
COPY --chown=800 seismic-store-cpp-lib /home/me/sdapi/
COPY --chown=800 ["sd-env/build-template.sh", "sd-env/*.patch", "/home/me/" ]
USER me

ARG AZURE_BUILDID
ENV AZURE_BUILDID=${AZURE_BUILDID}
RUN ./build-template.sh

# If stopping the build at this point, /home/me/sdapi_linux64.tar.gz
# can be extracted from the image and deployed e.g. as a universal package.
