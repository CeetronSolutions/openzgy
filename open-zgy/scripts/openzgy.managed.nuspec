<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>OpenZGY.Managed</id>
        <!-- azure/openzgy-windows.yml will patch this to the real version. -->
        <version>0.0.0</version>
        <authors>SLB</authors>
        <owners>SLB</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Managed API for OpenZGY</description>
        <dependencies>
            <dependency id="OpenZGY.Native.Windows.V142.redist" version="[1.0.0,1.2.0)"/>
        </dependencies>
    </metadata>
    <files>
        <file src="..\build\deploy\managed\x64\Release\OpenZGY.Managed.dll" target="lib\netstandard2.0\" />
        <file src="..\build\deploy\managed\x64\Release\OpenZGY.Managed.pdb" target="lib\netstandard2.0\" />
    </files>
</package>
