# Create a minimal docker image containing OpenZGY

FROM rockylinux/rockylinux:8
ARG CLEAN_BUILD_COUNTER=5
ENV CLEAN_BUILD_COUNTER=${CLEAN_BUILD_COUNTER}
RUN dnf -y install libgomp findutils
RUN set -e; dnf -y install python38-devel python39-devel python3.11-devel; \
    update-alternatives --set python3 /usr/bin/python3.8; \
    for pp in python3.8 python3.9 python3.11; do \
        ${pp} -m ensurepip; \
        ${pp} -m pip install --upgrade pip; \
        ${pp} -m pip install wheel numpy cython; \
    done

# Workaround for a bug in the Azure SDK or one of its dependencies.
RUN test -r /etc/ssl/cert.pem || ln -s /etc/pki/tls/cert.pem /etc/ssl/cert.pem
WORKDIR /home/me/oz
ADD openzgy-install.tgz build/deploy

# Pre-install OpenZGY in each Python environment to make it more
# convenient to use the :test image for ad hoc experiments. The
# drawback is that the tests in test_inside.sh and possibly others
# will need to uninstall them before doing their stuff.
# TODO, do this in all the disros, or none.
RUN PYTHONS=$(/bin/ls -1 /usr/bin/python3[.0-9]* | grep '/python3[.0-9]*$'); \
    for pp in ${PYTHONS}; do \
        for wheel in build/deploy/wrapper/*-gcc*/OpenZgyBindings-*.whl; do \
            echo "Try to install $(basename ${wheel}) in ${pp}"; \
            ${pp} -m pip install ${wheel} || echo "Failure ignored."; \
        done; \
    done

# Optional: Prepare for running unit tests
RUN tar xvf build/deploy/testscripts.tar; \
    dnf -y install bzip2 curl valgrind cpio diffutils

# Specific to wrapper/test/docker/test_inside.sh
# Note: Do not install /usr/bin/virtualenv from "virtualenv" in rocky 8.
# This will download python3-virtualenv-15 which is too old (py3.6).
# The correct version can be installed by python3 -m pip install virtualenv.
# But at this point I don't really care. Users ought to use "venv" instead.
RUN dnf install -y gcc-c++

# Enable these to allow the "test" image to run the copytimes.sh test.
# Note that the oldtools folder has not been committed to git.
#COPY oldtools/ oldtools/
#COPY private/*.sh private/
#COPY oldtools/dropcache /usr/local/bin/dropcache
#RUN chmod 4555 /usr/local/bin/dropcache

