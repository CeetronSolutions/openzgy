##    ln -s /host/data/slbauth.tk /home/me/.sdcfg/slbauth.tk
##    cp -b -S .orig oldtools/config.yaml /usr/local/sdutil/sdlib/config.yaml

# Optional: Run as a regular user
RUN adduser -u 800 -g users -G wheel me; \
    dnf -y install sudo procps-ng psmisc; \
    echo 'me ALL = (ALL) NOPASSWD: ALL' >> /etc/sudoers; \
    chown -R me /home/me

# Copy additional files for ad-hoc tests.
#COPY --chown=800 [ "private/zgyconvert-perftest.sh*", "private/Volve*", "/home/me/" ]

USER me
