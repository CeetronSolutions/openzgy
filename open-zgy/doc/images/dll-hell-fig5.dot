digraph DependencyTree {

node [
  style=filled,
  fillcolor=lightgray,
  shape=rect
]

"CentOS 8\nSymbol clash\nAll must use the\nsame library" [color=white, fillcolor=white]
"azure*.so*"
"libcrypto.so.1.1"
"libcrypto.so.3"
"libcurl.so.4"
"libopenvds.so.2"
