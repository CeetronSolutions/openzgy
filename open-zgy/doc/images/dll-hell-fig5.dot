"azure*.so*" -> "libcurl.so.4"
"azure*.so*" -> "libssl.so.3"
"libcurl.so.4" -> "libcrypto.so.3"
"libcurl.so.4" -> "libssl.so.3"
"libopenvds.so.2" -> "libcrypto.so.1.1"
"libopenvds.so.2" -> "libcurl.so.4"
"libopenvds.so.2" -> "libsdapi.so.3"
"libopenvds.so.2" -> "libssl.so.1.1"
"libopenzgy.so.0.2" -> "libsdapi.so.3"
"libopenzgy.so.0.2" -> "libzfp.so.0"
"libsdapi.so.3" -> "azure*.so*"
"libsdapi.so.3" -> "libcrypto.so.3"
"libsdapi.so.3" -> "libcurl.so.4"
"libsdapi.so.3" -> "libssl.so.3"
"libssl.so.3" -> "libcrypto.so.3"
"libzgytool.so.0.1" -> "libopenvds.so.2"
"libzgytool.so.0.1" -> "libopenzgy.so.0.2"
